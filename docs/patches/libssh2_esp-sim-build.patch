diff --git i/CMakeLists.txt w/CMakeLists.txt
index b568b77..7f9af8a 100644
--- i/CMakeLists.txt
+++ w/CMakeLists.txt
@@ -1,3 +1,56 @@
+if(BUILD_SIMULATOR)
+    set(LIBSSH2_DIR libssh2)
+    # Use WinCNG (Windows Crypto API) — no external packages needed
+    set(CSOURCES_SIM
+        ${LIBSSH2_DIR}/src/agent.c
+        ${LIBSSH2_DIR}/src/bcrypt_pbkdf.c
+        ${LIBSSH2_DIR}/src/channel.c
+        ${LIBSSH2_DIR}/src/comp.c
+        ${LIBSSH2_DIR}/src/chacha.c
+        ${LIBSSH2_DIR}/src/cipher-chachapoly.c
+        ${LIBSSH2_DIR}/src/crypt.c
+        ${LIBSSH2_DIR}/src/global.c
+        ${LIBSSH2_DIR}/src/hostkey.c
+        ${LIBSSH2_DIR}/src/keepalive.c
+        ${LIBSSH2_DIR}/src/kex.c
+        ${LIBSSH2_DIR}/src/knownhost.c
+        ${LIBSSH2_DIR}/src/mac.c
+        ${LIBSSH2_DIR}/src/misc.c
+        ${LIBSSH2_DIR}/src/packet.c
+        ${LIBSSH2_DIR}/src/pem.c
+        ${LIBSSH2_DIR}/src/poly1305.c
+        ${LIBSSH2_DIR}/src/publickey.c
+        ${LIBSSH2_DIR}/src/scp.c
+        ${LIBSSH2_DIR}/src/session.c
+        ${LIBSSH2_DIR}/src/sftp.c
+        ${LIBSSH2_DIR}/src/transport.c
+        ${LIBSSH2_DIR}/src/userauth.c
+        ${LIBSSH2_DIR}/src/userauth_kbd_packet.c
+        ${LIBSSH2_DIR}/src/version.c
+        ${LIBSSH2_DIR}/src/blowfish.c
+        ${LIBSSH2_DIR}/src/wincng.c
+    )
+    add_library(libssh2_esp STATIC ${CSOURCES_SIM})
+    target_compile_definitions(libssh2_esp PRIVATE
+        LIBSSH2_WINCNG
+        # No HAVE_CONFIG_H → libssh2_setup.h uses its built-in _WIN32 branch;
+        # compat.h (which includes esp_netif.h) is NOT included.
+    )
+    target_include_directories(libssh2_esp PUBLIC
+        ${CMAKE_CURRENT_SOURCE_DIR}/${LIBSSH2_DIR}/src
+        ${CMAKE_CURRENT_SOURCE_DIR}/${LIBSSH2_DIR}/include
+        ${CMAKE_CURRENT_SOURCE_DIR}
+    )
+    target_link_libraries(libssh2_esp PRIVATE idfsim bcrypt ws2_32 crypt32)
+    if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+        target_compile_options(libssh2_esp PRIVATE
+            -Wno-format -Wno-uninitialized -Wno-narrowing -Wno-error)
+    endif()
+    return()   # Skip rest of file (IDF-only)
+endif()
+
+# ── IDF-only content follows ──
+
 set(LIBSSH2_DIR libssh2)
 
 set(CSOURCES    ${LIBSSH2_DIR}/src/agent.c
@@ -40,6 +93,7 @@ idf_component_register( SRCS ${CSOURCES}
 # Differences in platform data type sizes generate print formating warnings.
 # Disable treatment of these warnings as errors.
 idf_build_set_property(COMPILE_OPTIONS "-Wno-error=format" APPEND)
+idf_build_set_property(COMPILE_OPTIONS "-Wno-format" APPEND)
 
 idf_build_set_property(COMPILE_OPTIONS "-Wno-error=maybe-uninitialized" APPEND)
 idf_build_set_property(COMPILE_OPTIONS "-Wno-error=uninitialized" APPEND)
